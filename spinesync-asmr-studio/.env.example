# mock = client-only simulation (default)
# server = SQLite + ffmpeg pipeline via /api/*
NEXT_PUBLIC_PIPELINE_MODE=server

# Vercel / serverless: use bundled ffmpeg (ffmpeg-static) or set FFMPEG_PATH / FFPROBE_PATH
# Durable jobs on Vercel require STORAGE_DRIVER=s3 (local /tmp is ephemeral)

# Phase B integrations (optional — fallbacks when unset)
# OPENAI_API_KEY=sk-...
# OPENAI_COPY_MODEL=gpt-4o-mini
# AYRSHARE_API_KEY=...
# APP_BASE_URL=https://your-public-host.com

# Phase C — storage, queue, Remotion
# STORAGE_DRIVER=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=spinesync-media
# AWS_CLOUDFRONT_DOMAIN=dxxx.cloudfront.net
# JOB_EXECUTOR=inline
# For long renders on Vercel: JOB_EXECUTOR=worker + JOB_QUEUE_BACKEND=redis + REDIS_URL
# Run worker on a VM: npm run worker:pipeline
# REMOTION_RENDER=local
# REMOTION_RENDER=lambda  # not deployed — falls back to ffmpeg
# SPINESYNC_DEFAULT_API_KEY=sk_dev_...
# SPINESYNC_SESSION_SECRET=change-me-long-random
# SPINESYNC_MEDIA_TOKEN_SECRET=change-me-long-random
# SPINESYNC_REQUIRE_API_KEY=true
# JOB_QUEUE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379
