{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci && npm rebuild better-sqlite3",
  "env": {
    "NEXT_PUBLIC_PIPELINE_MODE": "server",
    "SPINESYNC_DATA_ROOT": "/tmp/spinesync"
  },
  "functions": {
    "app/api/jobs/**": {
      "maxDuration": 300,
      "memory": 3009
    },
    "app/api/preview/**": {
      "maxDuration": 120,
      "memory": 3009
    },
    "app/api/assets/**": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
