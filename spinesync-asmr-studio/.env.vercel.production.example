# Copy to .env.vercel.production (gitignored), fill AWS values, then:
#   VERCEL_TOKEN=... npm run vercel:sync-env
#   VERCEL_TOKEN=... npm run vercel:deploy

NEXT_PUBLIC_PIPELINE_MODE=server
SPINESYNC_DATA_ROOT=/tmp/spinesync
# Hobby default: Vercel Blob (no AWS). Use s3 + AWS_* below instead if preferred.
STORAGE_DRIVER=blob

# Optional S3 (instead of blob):
# STORAGE_DRIVER=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_CLOUDFRONT_DOMAIN=dxxx.cloudfront.net

APP_BASE_URL=https://spinesync-asmr-studio.vercel.app

# Leave blank to auto-generate on sync:
SPINESYNC_SESSION_SECRET=
SPINESYNC_MEDIA_TOKEN_SECRET=

# Optional
# OPENAI_API_KEY=
# AYRSHARE_API_KEY=
# SPINESYNC_DEFAULT_API_KEY=
